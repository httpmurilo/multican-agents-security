# Multica self-host local-only defaults
# Use only on a trusted local machine.
MULTICA_IMAGE_TAG=latest
MULTICA_POSTGRES_PASSWORD=multica
MULTICA_JWT_SECRET=change-this-before-sharing
MULTICA_APP_ENV=development
MULTICA_FRONTEND_ORIGIN=http://localhost:3000
MULTICA_LOCAL_UPLOAD_BASE_URL=http://localhost:8080
MULTICA_DEV_VERIFICATION_CODE=888888
MULTICA_RESEND_FROM_EMAIL=noreply@multica.local
